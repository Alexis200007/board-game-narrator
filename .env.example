# Copy this file to .env.local and fill it in. Never commit .env.local.
ELEVENLABS_API_KEY=

# Optional: your plan's price, to show voices in dollars in Settings > Costs.
#ELEVENLABS_USD_PER_1000_CHARS=0.10

# How the server reaches Claude:
#   cli  (default) Claude Code, with your Claude plan ("claude auth login")
#   api  Anthropic API, billed per use, with the key below
CLAUDE_MODE=cli
ANTHROPIC_API_KEY=
